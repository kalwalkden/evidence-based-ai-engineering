# Single source of truth for CI tool versions.
#
# scripts/check.sh sources this file directly; the CI workflow appends it to
# $GITHUB_ENV. Keep it plain KEY=VALUE with no quoting or expansion so both
# consumers read it identically. Bump a version here and both follow.
UV_VERSION=0.11.28
RUFF_VERSION=0.16.3
YAMLLINT_VERSION=1.38.0
SHELLCHECK_VERSION=0.11.0.1
CODESPELL_VERSION=2.4.3
PYYAML_VERSION=6.0.2
PYTEST_VERSION=9.1.1
MARKDOWNLINT_VERSION=0.23.2
CSPELL_VERSION=10.0.1
# Node major used by CI. NODE_MIN_VERSION is the floor the pinned npm tools
# declare in their "engines" field (cspell needs >=22.18.0, markdownlint-cli2
# >=22); scripts/check.sh refuses to run the prose group below it so a newer
# local Node cannot hide a requirement CI's Node would fail on.
NODE_VERSION=24
NODE_MIN_VERSION=22.18.0
